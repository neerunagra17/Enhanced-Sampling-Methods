# us.template - umbrella window on phi (also the restraint of the 100 ps chained preparation).
# @CENTRE@ = window centre (rad). kJ/mol, rad, ps.
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
res: RESTRAINT ARG=phi AT=@CENTRE@ KAPPA=500.0
PRINT STRIDE=50 ARG=phi,psi,res.bias FILE=COLVAR      # every 0.1 ps
